      "destination": "https://app.kleoklaw.com",
      "permanent": true
    },
    {
      "source": "/app",
      "has": [{ "type": "host", "value": "www.kleoklaw.com" }],
      "destination": "https://app.kleoklaw.com",
      "permanent": true
    }
  ],
  "rewrites": [
