{
  "redirects": [
    {
      "source": "/download",
      "has": [{ "type": "host", "value": "kleoklaw.com" }],
      "destination": "https://app.kleoklaw.com",
      "permanent": true
    },
    {
      "source": "/app",
      "has": [{ "type": "host", "value": "kleoklaw.com" }],
      "destination": "https://app.kleoklaw.com",
      "permanent": true
    },
    {
      "source": "/download",
